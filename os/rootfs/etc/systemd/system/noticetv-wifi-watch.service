[Unit]
Description=NoticeTV: reconnect Wi-Fi after a real outage, not a single lost ping
After=network.target

[Service]
ExecStart=/usr/local/lib/noticetv/wifi-watch.sh
# on-failure: the script exits cleanly on a box without Wi-Fi, and must stay stopped there.
Restart=on-failure
RestartSec=30
SyslogIdentifier=noticetv-wifi-watch

[Install]
WantedBy=multi-user.target
