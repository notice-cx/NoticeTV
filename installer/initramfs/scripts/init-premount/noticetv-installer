#!/bin/sh
# The NoticeTV installer: writes NoticeTV OS from the USB stick it booted from to the computer's
# internal drive, then restarts into it. Runs in the installer's initramfs, which has no root
# filesystem to go on to, so it never returns on the installer's own boot.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

grep -qw noticetv.installer /proc/cmdline || exit 0
# The end-to-end test boots with noticetv.installer=test: the first drive, no questions, and a
# power-off instead of a restart so the test can go on to boot the installed drive.
TEST=""
if grep -q 'noticetv.installer=test' /proc/cmdline; then
    TEST=yes
fi

set -o pipefail
dmesg -n 1
FILES=/installer/noticetv

say() { printf '  %s\n' "$*"; }
screen() { printf '\033[2J\033[H\n'; say "NoticeTV installer"; echo; }

stop_with() {  # stop_with MESSAGE...: show it, then turn off on Enter
    for line in "$@"; do say "$line"; done
    echo
    if [ -z "$TEST" ]; then
        say "Press Enter to turn off the computer."
        read -r _
    fi
    poweroff -f
}

# ---- the installer's files, on the USB stick it booted from
screen
mkdir -p /installer
n=0
until DEV=$(blkid -L NOTICETVUSB 2>/dev/null) && [ -n "$DEV" ]; do
    if [ $n -ge 30 ]; then
        stop_with "This USB stick is missing the installer's files." \
            "Write the NoticeTV installer to it again, then start the computer from it."
    fi
    sleep 1
    n=$((n + 1))
done
mount -t vfat -o ro "$DEV" /installer || stop_with "The installer's files on this USB stick can't be read." \
    "Write the NoticeTV installer to it again, then start the computer from it."
IMAGE=$(ls "$FILES"/noticetv-os-*.img.xz)
NEED=$(cat "$FILES/image-bytes")
SOURCE=$(basename "$(readlink -f "/sys/class/block/${DEV#/dev/}/..")")

# ---- the drives it can go on: not the USB stick itself, and big enough
COUNT=0
for block in /sys/block/*; do
    name=${block##*/}
    case "$name" in
    loop* | ram* | zram* | sr* | fd* | dm-* | md* | nbd* | mmcblk*boot* | mmcblk*rpmb) continue ;;
    esac
    [ "$name" = "$SOURCE" ] && continue
    bytes=$(($(cat "$block/size") * 512))
    [ "$bytes" -ge "$NEED" ] || continue
    model=$(cat "$block/device/model" "$block/device/name" 2>/dev/null | head -n 1 | sed 's/[[:space:]]*$//')
    COUNT=$((COUNT + 1))
    eval "DRIVE_$COUNT=\$name"
    eval "LABEL_$COUNT=\"\${model:-\$name}  (\$((bytes / 1000000000)) GB)\""
done
if [ "$COUNT" -eq 0 ]; then
    stop_with "No drive was found to install NoticeTV on." \
        "NoticeTV needs an internal drive of at least $(((NEED + 999999999) / 1000000000)) GB."
fi

CHOICE=1
if [ "$COUNT" -gt 1 ] && [ -z "$TEST" ]; then
    while :; do
        screen
        say "Choose the drive to install NoticeTV on:"
        echo
        i=1
        while [ $i -le "$COUNT" ]; do
            eval "say \"  \$i  \$LABEL_$i\""
            i=$((i + 1))
        done
        echo
        printf '  Type its number and press Enter: '
        read -r CHOICE
        case "$CHOICE" in
        '' | *[!0-9]*) ;;
        *) [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le "$COUNT" ] && break ;;
        esac
    done
fi
eval "TARGET=/dev/\$DRIVE_$CHOICE LABEL=\$LABEL_$CHOICE"

# The installed system's root filesystem: partition 2 (sda -> sda2, nvme0n1 -> nvme0n1p2).
case "$TARGET" in
*[0-9]) ROOT_PART=${TARGET}p2 ;;
*) ROOT_PART=${TARGET}2 ;;
esac
mkdir -p /target

# ---- a drive that already has NoticeTV: change its settings, or install again
MODE=install
CURRENT_SSID=""
CURRENT_URL=""
if [ -b "$ROOT_PART" ] && mount -t ext4 -o ro "$ROOT_PART" /target 2>/dev/null; then
    if [ -f /target/etc/noticetv/noticetv.conf ]; then
        MODE=choose
        CURRENT_SSID=$(sed -n "s/^aWIFI_SSID\[0\]='\(.*\)'$/\1/p" /target/var/lib/dietpi/dietpi-wifi.db 2>/dev/null)
        CURRENT_URL=$(sed -n 's/^SOFTWARE_CHROMIUM_AUTOSTART_URL=//p' /target/boot/dietpi.txt)
        case "$CURRENT_URL" in file://*) CURRENT_URL="" ;; esac
    fi
    umount /target
fi
if [ "$MODE" = choose ]; then
    MODE=install
    if [ -z "$TEST" ]; then
        while :; do
            screen
            say "NoticeTV is already on $LABEL."
            echo
            say "  1  Change its Wi-Fi and dashboard"
            say "  2  Install NoticeTV again, erasing everything on the drive"
            echo
            printf '  Type 1 or 2 and press Enter: '
            read -r answer
            case "$answer" in
            1) MODE=settings; break ;;
            2) break ;;
            esac
        done
    fi
fi

if [ "$MODE" = install ] && [ -z "$TEST" ]; then
    screen
    say "NoticeTV will be installed on:"
    echo
    say "    $LABEL"
    echo
    say "This erases everything on that drive."
    echo
    say "Press Enter to install. To cancel, turn off the computer."
    read -r _
fi

# ---- the settings: asked before the install, so nobody waits on a question after it
SSID=$CURRENT_SSID
PASSWORD=""
NEW_PASSWORD=""
URL=$CURRENT_URL
if [ -n "$TEST" ]; then
    SSID=$(sed -n 's/.*noticetv\.test\.ssid=\([^ ]*\).*/\1/p' /proc/cmdline)
    PASSWORD=$(sed -n 's/.*noticetv\.test\.password=\([^ ]*\).*/\1/p' /proc/cmdline)
    NEW_PASSWORD=yes
    URL=$(sed -n 's/.*noticetv\.test\.dashboard=\([^ ]*\).*/\1/p' /proc/cmdline)
else
    screen
    say "Wi-Fi network name"
    if [ -n "$CURRENT_SSID" ]; then
        say "To keep $CURRENT_SSID, press Enter."
    else
        say "To use a network cable instead, press Enter."
    fi
    echo
    printf '  > '
    IFS= read -r answer
    [ -n "$answer" ] && SSID=$answer
    if [ -n "$SSID" ] && { [ "$SSID" != "$CURRENT_SSID" ] || [ -z "$CURRENT_SSID" ]; }; then
        while :; do
            screen
            say "Password for $SSID"
            say "For a network without a password, press Enter."
            echo
            printf '  > '
            IFS= read -r PASSWORD
            len=${#PASSWORD}
            if [ "$len" -eq 0 ] || { [ "$len" -ge 8 ] && [ "$len" -le 63 ]; }; then
                break
            fi
            echo
            say "A Wi-Fi password has 8 to 63 characters. Type it again."
            sleep 3
        done
        NEW_PASSWORD=yes
    fi
    while :; do
        screen
        say "Dashboard address"
        say "The page this screen shows, for example https://example.com/wall"
        if [ -n "$CURRENT_URL" ]; then
            say "To keep $CURRENT_URL, press Enter."
        else
            say "To show the NoticeTV start page for now, press Enter."
        fi
        echo
        printf '  > '
        read -r answer
        case "$answer" in
        '') break ;;
        *[[:space:]\'\"\\]*) echo; say "Type the address without spaces or quotes."; sleep 3 ;;
        http://* | https://*) URL=$answer; break ;;
        *) echo; say "Start the address with https:// or http://"; sleep 3 ;;
        esac
    done
fi

# ---- write, check, and make it the computer's first boot choice
if [ "$MODE" = install ]; then
    screen
    say "Installing NoticeTV on $LABEL"
    echo
    # Old partition tables at either end of the drive must not outlive the install.
    wipefs -a "$TARGET" >/dev/null 2>&1
    /usr/lib/noticetv/xz -dc -T0 -v "$IMAGE" | dd of="$TARGET" bs=4194304 2>/dev/null \
        || stop_with "Writing to the drive failed." "Check the drive, then start the computer from this USB stick again."
    sync
    echo
    say "Checking the installation..."
    echo 3 > /proc/sys/vm/drop_caches
    WRITTEN=$(head -c "$NEED" "$TARGET" | sha256sum | cut -d ' ' -f 1)
    if [ "$WRITTEN" != "$(cat "$FILES/image-sha256")" ]; then
        stop_with "The drive doesn't hold what was written to it." \
            "Start the computer from this USB stick to try again. If it fails again, the drive may be faulty."
    fi

    # A boot entry for NoticeTV, first in the boot order, so a USB stick left in doesn't start the
    # installer again. Firmware that refuses NVRAM writes still finds NoticeTV on its own.
    if [ -d /sys/firmware/efi ]; then
        grep -q " /sys/firmware/efi/efivars " /proc/mounts || mount -t efivarfs efivarfs /sys/firmware/efi/efivars
        for entry in $(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} NoticeTV.*/\1/p'); do
            efibootmgr -q -b "$entry" -B
        done
        efibootmgr -q -c -d "$TARGET" -p 1 -L NoticeTV -l '\EFI\debian\shimx64.efi' 2>/dev/null || true
    fi

    # The new partition table, so the installed root filesystem can be opened for the settings.
    blockdev --rereadpt "$TARGET"
    n=0
    until [ -b "$ROOT_PART" ] || [ $n -ge 10 ]; do
        sleep 1
        n=$((n + 1))
    done
fi

# ---- the settings, into the installed system
write_settings() {
    mount -t ext4 "$ROOT_PART" /target || return 1
    if [ -n "$NEW_PASSWORD" ] && [ -n "$SSID" ]; then
        # What DietPi's own Wi-Fi tool (dietpi-wifidb) keeps and generates: its database, holding
        # the key as wpa_passphrase's 64-digit hash rather than the password, and the
        # wpa_supplicant.conf the Wi-Fi interface reads.
        quoted_ssid=$(printf '%s' "$SSID" | sed "s/'/'\\\\''/g")
        if [ -n "$PASSWORD" ]; then
            key=$(/usr/lib/noticetv/wpa_passphrase "$SSID" "$PASSWORD" | sed -n 's/^[[:space:]]*psk=//p' | tail -n 1)
            keymgr=WPA-PSK
        else
            key=""
            keymgr=NONE
        fi
        {
            i=0
            while [ $i -lt 5 ]; do
                if [ $i -eq 0 ]; then
                    echo "aWIFI_SSID[0]='$quoted_ssid'"
                    echo "aWIFI_KEY[0]='$key'"
                    echo "aWIFI_KEYMGR[0]='$keymgr'"
                else
                    echo "aWIFI_SSID[$i]=''"
                    echo "aWIFI_KEY[$i]=''"
                    echo "aWIFI_KEYMGR[$i]='WPA-PSK'"
                fi
                for field in PROTO PAIRWISE AUTH_ALG EAP IDENTITY PASSWORD PHASE1 PHASE2 CERT; do
                    echo "aWIFI_${field}[$i]=''"
                done
                i=$((i + 1))
            done
        } > /target/var/lib/dietpi/dietpi-wifi.db
        country=$(sed -n 's/^AUTO_SETUP_NET_WIFI_COUNTRY_CODE=//p' /target/boot/dietpi.txt)
        # The name as hex: any character, quotes included, survives.
        hex_ssid=$(printf '%s' "$SSID" | od -A n -t x1 | tr -d ' \n')
        {
            echo "country=${country:-US}"
            echo "ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev"
            echo "update_config=1"
            echo "network={"
            echo "	ssid=$hex_ssid"
            echo "	scan_ssid=1"
            echo "	key_mgmt=$keymgr"
            [ -n "$key" ] && echo "	psk=$key"
            echo "}"
        } > /target/etc/wpa_supplicant/wpa_supplicant.conf
        chmod 600 /target/etc/wpa_supplicant/wpa_supplicant.conf /target/var/lib/dietpi/dietpi-wifi.db
    fi
    if [ -n "$URL" ]; then
        escaped=$(printf '%s' "$URL" | sed 's/[&|]/\\&/g')
        sed -i "s|^SOFTWARE_CHROMIUM_AUTOSTART_URL=.*|SOFTWARE_CHROMIUM_AUTOSTART_URL=$escaped|" /target/boot/dietpi.txt
        conf=/target/etc/noticetv/noticetv.conf
        if grep -q '^DASHBOARD_URL=' "$conf"; then
            sed -i "s|^DASHBOARD_URL=.*|DASHBOARD_URL='$escaped'|" "$conf"
        else
            echo "DASHBOARD_URL='$URL'" >> "$conf"
        fi
    fi
    sync
    umount /target
}
write_settings || stop_with "The settings could not be saved on the drive." \
    "Start the computer from this USB stick again, and choose to change the Wi-Fi and dashboard."
umount /installer

screen
if [ "$MODE" = install ]; then
    say "NoticeTV is installed."
else
    say "The settings are saved."
fi
echo
say "Wi-Fi:      ${SSID:-network cable}"
say "Dashboard:  ${URL:-the NoticeTV start page}"
echo
if [ -n "$TEST" ]; then
    poweroff -f
fi
say "Remove the USB stick. The computer restarts in 10 seconds."
sleep 10
reboot -f
